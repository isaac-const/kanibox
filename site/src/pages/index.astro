---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Icon from '../components/Icon.astro';
import { SECTIONS, TOTAL, TOP_ITEMS, INITIAL_BATCH } from '../lib/catalog';
import { shortDate } from '../lib/format';
import { withBase } from '../lib/url';

const updated = shortDate(INITIAL_BATCH);
---
<Base
  home
  title="KaniBox · ferramentas, apps e jogos que eu uso"
  description="Ferramentas, apps e jogos que o Isaac usa e recomenda. Sem afiliado, sem anúncio."
>
  <section class="hero" id="hero" aria-labelledby="hero-t">
    <div class="hero-main">
      <svg class="hero-knife" viewBox="0 0 32 32" aria-hidden="true">
        <rect x="2" y="12" width="20" height="10" rx="5" fill="var(--knife-body)" stroke="var(--knife-edge)" stroke-width="1.2" />
        <path d="M2 17a5 5 0 015-5h10a5 5 0 015 5z" fill="var(--accent)" />
        <path d="M20 17L29 7" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
        <path d="M19 15L26 6" stroke="var(--muted)" stroke-width="3.2" stroke-linecap="round" opacity=".6" />
      </svg>
      <div>
        <h1 id="hero-t">Kani<b>Box</b></h1>
        <p class="lead">Ferramentas, apps e jogos que eu uso e recomendo.</p>
        <p class="meta-line">{TOTAL} itens · atualizado em {updated} · sem afiliado, sem anúncio</p>
      </div>
    </div>
    <div class="top9" id="hero-top">
      <h2 class="top-t">Os que eu mais uso</h2>
      <ul class="top-list">
        {
          TOP_ITEMS.map((i) => (
            <li>
              <a href={i.url} target="_blank" rel="noopener noreferrer">
                <span class="ic">{i.icon ? <img src={withBase(`/icons/${i.icon}`)} alt="" width="26" height="26" loading="eager" decoding="async" /> : <b>{i.name[0]}</b>}</span>
                <span class="tn">
                  <b>{i.name}</b>
                  <small>{i.tipo}</small>
                </span>
                <span class="vh"> (abre em outra aba)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="tabsbar" id="tabsbar" role="tablist" aria-label="Seções">
    {
      SECTIONS.map((s) => (
        <button type="button" role="tab" data-tab={s.id} aria-selected="false">
          <Icon name={s.icon} size={16} />
          {s.title}
        </button>
      ))
    }
  </div>

  <div id="sections">
    {SECTIONS.map((s) => <Section section={s} />)}
  </div>
  <div class="empty" id="empty">
    <b>Nada com esses filtros.</b>
    Limpe um filtro ou mude a busca.
  </div>
</Base>

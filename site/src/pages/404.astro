---
import Base from '../layouts/Base.astro';
import { route } from '../lib/url';
import { t } from '../i18n';
---
<Base lang="pt" current="home" title="404 · KaniBox" description={t('pt', 'notFoundText')} alt={{ pt: route('pt', 'home'), en: route('en', 'home') }}>
  <div class="page">
    <h1>{t('pt', 'notFoundTitle')}</h1>
    <p>{t('pt', 'notFoundText')} <a href={route('pt', 'home')}>{t('pt', 'notFoundBack')}</a>.</p>
    <p lang="en">{t('en', 'notFoundTitle')}. <a href={route('en', 'home')}>{t('en', 'notFoundBack')}</a>.</p>
  </div>
</Base>

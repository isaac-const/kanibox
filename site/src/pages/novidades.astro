---
import Base from '../layouts/Base.astro';
import { batches } from '../lib/catalog';
import { longDate } from '../lib/format';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const list = batches();
---
<Base title="Novidades · KaniBox" description="O que entrou no KaniBox e quando.">
  <div class="page">
    <h1>Novidades</h1>
    <p>Cada adição entra aqui com a data. Também sai por <a href={`${base}/rss.xml`}>RSS</a>.</p>
    <div class="log">
      {
        list.map((b, i) => (
          <section>
            <time datetime={b.date}>{longDate(b.date)}</time>
            <h2>{i === list.length - 1 ? 'Lote inicial' : 'Novos itens'}: {b.items.length} itens</h2>
            <ul>
              {b.bySection.map((x) => <li><b>{x.section.title}</b> · {x.count}</li>)}
            </ul>
          </section>
        ))
      }
    </div>
    <p style="margin-top:28px">Itens do lote inicial não ganham selo de novo. A data de cada adição futura aparece aqui.</p>
  </div>
</Base>

---
import Icon from './Icon.astro';
import ItemRow from './ItemRow.astro';
import GameTile from './GameTile.astro';
import Tools from './tools/Tools';
import { groupsOf, countIn, TOOLS_SECTION_ID } from '../lib/catalog';
import { LOADER_NAMES, MC_DEFAULT_GROUP, type SectionDef } from '../lib/sections';

interface Props {
  section: SectionDef;
}
const { section } = Astro.props;
const isTools = section.id === TOOLS_SECTION_ID;
const isMc = section.id === 9;
const groups = isTools ? [] : groupsOf(section.id);
const total = countIn(section.id);
const count = isTools ? '12 ferramentas' : `${total} ${total === 1 ? 'item' : 'itens'}`;
---
<section class="sec" id={`s${section.id}`} data-s={section.id} aria-labelledby={`h${section.id}`}>
  <header class="sec-head">
    <span class="sec-ic"><Icon name={section.icon} size={22} /></span>
    <h2 class="sec-t" id={`h${section.id}`}>{section.title}</h2>
    <span class="sec-c" data-seccount>{count}</span>
  </header>
  <p class="sec-d">{section.desc}</p>

  {
    isMc && (
      <div class="tabs subtabs" role="tablist" aria-label="Minecraft">
        {groups.map((g) => (
          <button type="button" role="tab" data-sub={g.key} aria-selected={g.key === MC_DEFAULT_GROUP ? 'true' : 'false'}>
            {g.name} <small data-gcount>{g.items.length}</small>
          </button>
        ))}
      </div>
    )
  }

  {
    groups.map((g) => (
      <div class="grp" data-g={g.key} role={isMc ? 'tabpanel' : undefined}>
        {!isMc && (
          <h3>
            {g.name} <span class="n" data-gcount>{g.items.length}</span>
          </h3>
        )}
        {
          g.name === 'Mods' && (
            <>
              <div class="ldbar" role="group" aria-label="Loader dos mods">
                <span class="lbl">Loader</span>
                {['todos', 'fabric', 'forge', 'neoforge', 'quilt'].map((l) => (
                  <button type="button" class="opt" data-ld={l} aria-pressed={l === 'todos' ? 'true' : 'false'}>
                    {l === 'todos' ? 'Todos' : LOADER_NAMES[l]}
                  </button>
                ))}
              </div>
              <p class="ldsum" id="ldsum" aria-live="polite" />
            </>
          )
        }
        {
          g.view === 'tiles' ? (
            <ul class="tiles">{g.items.map((i) => <GameTile item={i} />)}</ul>
          ) : g.name === 'Mods' ? (
            <ul class="mods">{g.items.map((i) => <ItemRow item={i} compact />)}</ul>
          ) : (
            <ul class="list">{g.items.map((i) => <ItemRow item={i} />)}</ul>
          )
        }
      </div>
    ))
  }

  {isTools && <Tools client:visible />}
</section>

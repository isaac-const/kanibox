---
import Icon from './Icon.astro';
import ItemRow from './ItemRow.astro';
import GameTile from './GameTile.astro';
import Tools from './tools/Tools';
import { groupsOf, countIn, TOOLS_SECTION_ID } from '../lib/catalog';
import { LOADER_NAMES, SUBTABS, type SectionDef } from '../lib/sections';
import { t, type Lang } from '../i18n';

interface Props {
  section: SectionDef;
  lang: Lang;
  /** página própria da categoria: o título vira h1 */
  solo?: boolean;
}
const { section, lang, solo = false } = Astro.props;
const isTools = section.id === TOOLS_SECTION_ID;
const sub = SUBTABS[section.id];
const groups = isTools ? [] : groupsOf(section.id, lang);
const total = countIn(section.id);
const count = isTools ? t(lang, 'nTools', { n: 12 }) : t(lang, total === 1 ? 'nItem' : 'nItems', { n: total });
const H = solo ? 'h1' : 'h2';
---
<section class="sec" id={`s${section.id}`} data-s={section.id} aria-labelledby={`h${section.id}`}>
  <header class="sec-head">
    <span class="sec-ic"><Icon name={section.icon} size={22} /></span>
    <H class="sec-t" id={`h${section.id}`}>{section.title[lang]}</H>
    <span class="sec-c" data-seccount>{count}</span>
  </header>
  <p class="sec-d">{section.desc[lang]}</p>

  {
    sub && (
      <div class="seg subtabs" role="tablist" aria-label={section.title[lang]}>
        <span class="seg-pill" aria-hidden="true" />
        {groups.map((g) => (
          <button type="button" role="tab" data-sub={g.key} aria-selected={g.key === sub ? 'true' : 'false'}>
            {g.label} <small data-gcount>{g.items.length}</small>
          </button>
        ))}
      </div>
    )
  }

  {
    groups.map((g) => (
      <div class:list={['grp', { 'sub-off': !!sub && g.key !== sub }]} data-g={g.key} role={sub ? 'tabpanel' : undefined}>
        {!sub && (
          <h3>
            {g.label} <span class="n" data-gcount>{g.items.length}</span>
          </h3>
        )}
        {
          g.name === 'Mods' && (
            <>
              <div class="ldbar" role="group" aria-label={t(lang, 'loaderAria')}>
                <span class="lbl">{t(lang, 'loaderLabel')}</span>
                {['todos', 'fabric', 'forge', 'neoforge', 'quilt'].map((l) => (
                  <button type="button" class="opt" data-ld={l} aria-pressed={l === 'todos' ? 'true' : 'false'}>
                    {l === 'todos' ? t(lang, 'loaderAll') : LOADER_NAMES[l]}
                  </button>
                ))}
              </div>
              <p class="ldsum" id="ldsum" aria-live="polite" />
            </>
          )
        }
        {
          g.view === 'tiles' ? (
            <ul class="tiles">{g.items.map((i) => <GameTile item={i} lang={lang} />)}</ul>
          ) : g.view === 'mods' ? (
            <ul class="mods">{g.items.map((i) => <ItemRow item={i} lang={lang} compact />)}</ul>
          ) : (
            <ul class="list">{g.items.map((i) => <ItemRow item={i} lang={lang} />)}</ul>
          )
        }
      </div>
    ))
  }

  {isTools && <Tools client:load lang={lang} />}
</section>

---
import Icon from './Icon.astro';
import type { Item } from '../lib/catalog';
import { LOADER_NAMES } from '../lib/sections';
import { withBase } from '../lib/url';

interface Props {
  item: Item;
  /** versão compacta, usada nos mods */
  compact?: boolean;
}
const { item, compact = false } = Astro.props;

const LIC_CLASS: Record<string, string> = { 'Código aberto': 'open', Grátis: 'free', Freemium: 'freem', Pago: 'paid' };
const licClass = LIC_CLASS[item.lic] ?? '';
const verified = item.lic_src?.startsWith('GitHub:') || item.lic_src?.startsWith('Modrinth:');
const licTitle = item.lic ? (verified ? `Fonte: ${item.lic_src}` : 'Informada à mão, ainda não conferida') : undefined;
const sub = [item.tipo, item.host].filter(Boolean).join(' · ');
const isMod = item.tipo === 'Mod';
const isMc = item.kind === 'mc';
const iconSrc = isMc && item.mc_icon ? withBase(`/mc/${item.mc_icon}`) : item.icon && !item.mono ? withBase(`/icons/${item.icon}`) : null;
const px = isMc ? 40 : 26;
---
<li class:list={['row', { soon: item.soon }]} data-id={item.id} data-ld={isMod && item.loaders?.length ? item.loaders.join(' ') : undefined}>
  <span class:list={['ic', { big: isMc }]}>
    {iconSrc ? <img src={iconSrc} alt="" width={px} height={px} loading="lazy" decoding="async" /> : <b>{item.name[0]}</b>}
  </span>
  <div style="min-width:0">
    <div class="nm">
      {
        item.url ? (
          <a href={item.url} target="_blank" rel="noopener noreferrer">
            {item.name}
            <span class="vh"> (abre em outra aba)</span>
          </a>
        ) : (
          <span>{item.name}</span>
        )
      }
      {item.via && <span class="bd">via {item.via}</span>}
      {item.ini && <span class="bd on">Para iniciantes</span>}
      {item.soon && <span class="bd">em desenvolvimento</span>}
    </div>
    {!compact && <div class="sub">{sub}</div>}
  </div>
  <div class="meta">
    {
      isMod ? (
        <span class="ld">{item.loaders?.map((l) => <span data-l={l}>{LOADER_NAMES[l]}</span>)}</span>
      ) : (
        <>
          {item.lic && (
            <span class:list={['lic', licClass]} title={licTitle}>
              <i />
              {item.lic}
            </span>
          )}
          {item.plat.length > 0 && <span class="pl">{item.plat.join(' · ')}</span>}
        </>
      )
    }
  </div>
  {
    !compact && (
      <span class="go">{item.url ? <Icon name="arrow" size={15} /> : null}</span>
    )
  }
  {item.note && <p class="note">{item.note}</p>}
</li>

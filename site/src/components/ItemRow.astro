---
import Icon from './Icon.astro';
import { loc, type Item } from '../lib/catalog';
import { LOADER_NAMES } from '../lib/sections';
import { withBase } from '../lib/url';
import { t, type Lang } from '../i18n';

interface Props {
  item: Item;
  lang: Lang;
  /** versão compacta, usada nos mods */
  compact?: boolean;
}
const { item, lang, compact = false } = Astro.props;
const l = loc(item, lang);

const LIC_CLASS: Record<string, string> = { 'Código aberto': 'open', Grátis: 'free', Freemium: 'freem', Pago: 'paid' };
const licClass = LIC_CLASS[item.lic] ?? '';
const verified = item.lic_src?.startsWith('GitHub:') || item.lic_src?.startsWith('Modrinth:');
const licTitle = item.lic ? (verified ? t(lang, 'licSource', { src: item.lic_src ?? '' }) : t(lang, 'licHand')) : undefined;
const sub = [l.tipo, item.host].filter(Boolean).join(' · ');
const isMod = item.tipo === 'Mod';
const isMc = item.kind === 'mc';
const iconSrc = isMc && item.mc_icon ? withBase(`/mc/${item.mc_icon}`) : item.icon && !item.mono ? withBase(`/icons/${item.icon}`) : null;
const px = isMc ? 40 : 26;
---
<li class:list={['row', { soon: item.soon }]} data-id={item.id} data-ld={isMod && item.loaders?.length ? item.loaders.join(' ') : undefined}>
  <span class:list={['ic', { big: isMc }]}>
    {iconSrc ? <img src={iconSrc} alt="" width={px} height={px} loading="lazy" decoding="async" /> : <b>{item.name[0]}</b>}
  </span>
  <div style="min-width:0">
    <div class="nm">
      {
        item.url ? (
          <a href={item.url} target="_blank" rel="noopener noreferrer">
            {item.name}
            <span class="vh"> {t(lang, 'newTab')}</span>
          </a>
        ) : (
          <span>{item.name}</span>
        )
      }
      {item.via && <span class="bd">{t(lang, 'via', { x: item.via })}</span>}
      {item.ini && <span class="bd on">{t(lang, 'beginners')}</span>}
      {item.soon && <span class="bd">{t(lang, 'soon')}</span>}
    </div>
    {!compact && <div class="sub">{sub}</div>}
  </div>
  <div class="meta">
    {
      isMod ? (
        <span class="ld">{item.loaders?.map((x) => <span data-l={x}>{LOADER_NAMES[x]}</span>)}</span>
      ) : (
        <>
          {item.lic && (
            <span class:list={['lic', licClass]} title={licTitle}>
              <i />
              {t(lang, `lic.${item.lic}`)}
            </span>
          )}
          {item.plat.length > 0 && <span class="pl">{item.plat.join(' · ')}</span>}
        </>
      )
    }
  </div>
  {!compact && <span class="go">{item.url ? <Icon name="arrow" size={15} /> : null}</span>}
  {l.note && <p class="note">{l.note}</p>}
</li>

---
import '../styles/fonts.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SECTIONS, THEMES } from '../lib/sections';
import { FILTER_INDEX } from '../lib/catalog';
import hankenUrl from '../assets/fonts/hanken-grotesk-400.woff2?url';
import familjenUrl from '../assets/fonts/familjen-grotesk-700.woff2?url';

interface Props {
  title: string;
  description: string;
  /** página inicial: mostra busca, filtros e o canivete */
  home?: boolean;
}
const { title, description, home = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: `${base}/`, label: 'Início', match: '/' },
  { href: `${base}/novidades`, label: 'Novidades', match: '/novidades' },
  { href: `${base}/sobre`, label: 'Sobre', match: '/sobre' },
];
---
<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="KaniBox: novidades" href={`${base}/rss.xml`} />
    <link rel="preload" as="font" type="font/woff2" href={hankenUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={familjenUrl} crossorigin />
    <script is:inline>
      /* Tema antes da primeira pintura, sem piscar. Só dois temas: dark e white (os vermelhos). */
      (function () {
        var themes = ['dark', 'white'];
        var t = null;
        try { t = localStorage.getItem('kb-theme'); } catch (e) {}
        if (!t || themes.indexOf(t) < 0) t = matchMedia('(prefers-color-scheme: light)').matches ? 'white' : 'dark';
        var h = document.documentElement;
        h.dataset.theme = t;
        h.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Pular para o conteúdo</a>
    <header class="top">
      <div class="wrap">
        <div class="bar">
          <a class="logo" href={`${base}/`} aria-label="KaniBox, início">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <rect x="2" y="12" width="20" height="10" rx="5" fill="var(--knife-body)" stroke="var(--knife-edge)" stroke-width="1.2" />
              <path d="M2 17a5 5 0 015-5h10a5 5 0 015 5z" fill="var(--accent)" />
              <path d="M20 17L29 7" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
              <path d="M19 15L26 6" stroke="var(--muted)" stroke-width="3.2" stroke-linecap="round" opacity=".6" />
            </svg>
            <span>Kani<b>Box</b></span>
          </a>
          {
            home ? (
              <label class="search" id="searchBox">
                <Icon name="search" size={17} />
                <input id="q" type="search" placeholder="Buscar por nome, tipo ou site" autocomplete="off" spellcheck="false" aria-label="Buscar" />
                <button type="button" id="qClear" aria-label="Limpar busca">
                  <Icon name="close" size={14} />
                </button>
              </label>
            ) : (
              <nav class="navlinks" aria-label="Páginas">
                {nav.map((n) => (
                  <a href={n.href} aria-current={path === n.match ? 'page' : undefined}>{n.label}</a>
                ))}
              </nav>
            )
          }
          <a class="round" href={`${base}/novidades`} aria-label="Novidades"><Icon name="bell" size={19} /></a>
          <div class="theme-wrap">
            <button class="round" id="themeBtn" type="button" aria-label="Trocar tema" aria-expanded="false" aria-controls="themes">
              <Icon name="theme" size={19} />
            </button>
            <div class="themes" id="themes" role="group" aria-label="Temas">
              {
                THEMES.map((t) => (
                  <button type="button" data-t={t.id} aria-pressed="false">
                    <span class="sw" style={`background:${t.bg};--c2:${t.accent}`} />
                    {t.name}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
        {
          home && (
            <div class="filters" id="filters">
              {
                [['plat', 'Plataforma'], ['tipo', 'Tipo'], ['lic', 'Licença']].map(([f, label]) => (
                  <button class="fchip" type="button" data-f={f} aria-expanded="false" aria-controls="panel">
                    {label}
                    <b />
                    <Icon name="chev" size={12} />
                  </button>
                ))
              }
              <button class="fchip view" id="viewBtn" type="button" aria-pressed="false" title="Mostrar uma seção por vez, em abas">
                <Icon name="tabs" size={14} />
                Abas
              </button>
              <span class="sum">
                <button class="clear" id="clear" type="button">Limpar filtros</button>
                <span id="sum" aria-live="polite" />
              </span>
            </div>
          )
        }
      </div>
    </header>
    {home && <div class="fpanel" id="panel" role="dialog" aria-label="Filtro" />}

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site">
      <div class="stripe" aria-hidden="true"></div>
      <div class="wrap foot-grid">
        <div class="brand">
          <a class="logo" href={`${base}/`} aria-label="KaniBox, início">
            <svg viewBox="0 0 32 32" aria-hidden="true">
              <rect x="2" y="12" width="20" height="10" rx="5" fill="var(--knife-body)" stroke="var(--knife-edge)" stroke-width="1.2" />
              <path d="M2 17a5 5 0 015-5h10a5 5 0 015 5z" fill="var(--accent)" />
              <path d="M20 17L29 7" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
              <path d="M19 15L26 6" stroke="var(--muted)" stroke-width="3.2" stroke-linecap="round" opacity=".6" />
            </svg>
            <span>Kani<b>Box</b></span>
          </a>
          <p>Ferramentas, apps e jogos que eu uso e recomendo.</p>
          <p class="made">Feito pelo Isaac, em Timon, Maranhão.</p>
        </div>
        <nav aria-label="Explorar">
          <h2>Explorar</h2>
          <a href={`${base}/#s13`}>Meus apps</a>
          <a href={`${base}/#s12`}>Ferramentas</a>
          <a href={`${base}/novidades`}>Novidades</a>
          <a href={`${base}/sobre`}>Sobre</a>
        </nav>
        <nav aria-label="Links">
          <h2>Links</h2>
          <a href="https://github.com/isaac-const" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://github.com/isaac-const/kanibox" target="_blank" rel="noopener noreferrer">Código do site</a>
          <a href={`${base}/rss.xml`}>Feed RSS</a>
        </nav>
        <div>
          <h2>Critério</h2>
          <p>Só entra o que eu uso ou usaria. Nenhum link é afiliado e não há anúncio.</p>
        </div>
      </div>
      <div class="wrap legal">
        <span>Marcas e imagens pertencem aos seus donos.</span>
        <a href="#main">Voltar ao topo ↑</a>
      </div>
    </footer>

    {
      home && (
        <nav class="kdock" id="kdock" aria-label="Seções">
          <button class="kh" id="kh" type="button" aria-label="Dobrar ou abrir o canivete" aria-pressed="false" title="Dobrar ou abrir o canivete"><i /></button>
          <div class="blades" id="blades">
            {
              SECTIONS.map((s, k) => (
                <a class="blade" style={`--k:${k}`} href={`#s${s.id}`} data-s={s.id} aria-label={s.title}>
                  <Icon name={s.icon} size={19} />
                  <span class="lab">{s.title}</span>
                </a>
              ))
            }
          </div>
        </nav>
      )
    }
    {home && <script is:inline type="application/json" id="idx" set:html={JSON.stringify(FILTER_INDEX)} />}
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
